void ReadRawAngle() {
Wire.beginTransmission(0x36);
Wire.write(0x0D);
Wire.endTransmission();
Wire.requestFrom(0x36, 1);
while (Wire.available() == 0);
int lowbyte = Wire.read();
Wire.beginTransmission(0x36);
Wire.write(0x0C);
Wire.endTransmission();
Wire.requestFrom(0x36, 1);
while (Wire.available() == 0);
word highbyte = Wire.read();
highbyte = highbyte << 8;
int rawAngle = highbyte | lowbyte;
degAngle = rawAngle * 0.087890625;
}
void correctAngle() {
correctedAngle = degAngle- startAngle;
if (correctedAngle < 0) correctedAngle += 360;
if (correctedAngle > 360) correctedAngle-= 360;
if (correctedAngle > 270.0) correctedAngle = correctedAngle- 360.0;
}
void checkMagnetPresence() {
int magnetStatus = 0;
while ((magnetStatus & 32) != 32) {
magnetStatus = 0;
Wire.beginTransmission(0x36);
Wire.write(0x0B);
Wire.endTransmission();
Wire.requestFrom(0x36, 1);
while (Wire.available() == 0);
magnetStatus = Wire.read();
if (!(magnetStatus & 32)) {
Serial.println("Waiting for magnet...");
delay(500);
}
}
Serial.println("Magnet found.");

def load_vertices_from_3mf(filepath):
"""Load vertex coordinates from a 3MF file."""
if not filepath.exists():
raise FileNotFoundError(f"Library component not found: {filepath}")
with zipfile.ZipFile(filepath, ’r’) as z:
model_xml = z.read("3D/3dmodel.model")
tree = ET.ElementTree(ET.fromstring(model_xml))
root = tree.getroot()
verts = []
for v in root.findall(".//m:vertex", ns):
verts.append([
float(v.get("x", 0)),
float(v.get("y", 0)),
float(v.get("z", 0))
])
if len(verts) < 3:
raise ValueError(f"No vertices found in {filepath}")
return np.array(verts)
def compute_bbox(pts):
"""Compute bounding box, centre, and size of a mesh."""
min_vals = pts.min(axis=0)
max_vals = pts.max(axis=0)
centre = (min_vals + max_vals) / 2.0
size = max_vals- min_vals
return centre, min_vals, max_vals, size
def apply_translation_to_xml_vertices(root, dx, dy, dz):
"""Apply translation to all vertices in XML."""
if dx == 0 and dy == 0 and dz == 0:
return
for v in root.findall(".//m:vertex", ns):
x = float(v.get("x", 0))
y = float(v.get("y", 0))
z = float(v.get("z", 0))
v.set("x", f"{x + dx:.6f}")
v.set("y", f"{y + dy:.6f}")
v.set("z", f"{z + dz:.6f}")

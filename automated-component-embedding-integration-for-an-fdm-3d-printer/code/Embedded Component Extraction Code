def rotation_matrix_to_euler_zyx(R):
"""Convert rotation matrix to Euler angles."""
sy = np.sqrt(R[0, 0] ** 2 + R[1, 0] ** 2)
singular = sy < 1e-9
if not singular:
yaw = np.arctan2(R[1, 0], R[0, 0])
pitch = np.arctan2(-R[2, 0], sy)
roll = np.arctan2(R[2, 1], R[2, 2])
else:
yaw = np.arctan2(-R[0, 1], R[1, 1])
pitch = np.arctan2(-R[2, 0], sy)
roll = 0.0
return float(np.degrees(yaw)), float(np.degrees(pitch)), float(np.degrees(
roll))
def kabsch_rotation(A, B):
"""Compute rotation matrix aligning mesh B to mesh A."""
if A.shape != B.shape:
raise ValueError("Vertex count mismatch between canonical and
extracted mesh.")
cA = A.mean(axis=0)
cB = B.mean(axis=0)

def extract_layer_height_from_gcode(gcode_path: Path):
"""Extract layer height from G-code file."""
z_values = []
with open(gcode_path, "r") as f:
for line in f:
line = line.strip()
if line.lower().startswith(";layer height:"):
return float(line.split(":")[1].strip())
if line.startswith(";Z:"):
try:
z_values.append(float(line.split(":")[1]))
